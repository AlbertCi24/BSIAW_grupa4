# Skopiuj do .env i zmień wartości. Plik .env nie trafia do repo.

# Wygeneruj: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=zmien-mnie

# Postgres w docker-compose (port 5433 na hoście, żeby nie gryzł się z lokalnym Postgresem)
POSTGRES_USER=kinoteka
POSTGRES_PASSWORD=kinoteka-dev
POSTGRES_DB=kinoteka
DATABASE_URL=postgresql+psycopg://kinoteka:kinoteka-dev@127.0.0.1:5433/kinoteka

# true dopiero za HTTPS (w chmurze za load balancerem z TLS)
SESSION_COOKIE_SECURE=false
SESSION_MINUTES=30

# Liczba proxy przed aplikacją (load balancer = 1). Lokalnie 0.
TRUSTED_PROXIES=0
